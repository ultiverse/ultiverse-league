# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ultiverse?sslmode=require

# Environment
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Server Configuration
PORT=3000

# Note: Copy this file to .env.local and customize for your environment
# UC credentials are stored per-user in the integration_connections table